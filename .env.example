# Server-side credential created in the MediaRuntime account UI.
MEDIARUNTIME_API_KEY=

# HTTP(S), gs://, or (for the Node/Python SDKs) a local file path.
MEDIARUNTIME_SOURCE=

# Frozen alias appropriate for the selected source: video.web, audio.web, or image.web.
MEDIARUNTIME_OUTPUT_ALIAS=video.web

# Where quickstarts save the canonical ZIP output bundle.
MEDIARUNTIME_DOWNLOAD_PATH=outputs.zip

# Configure this under Account → Webhooks. Needed only by webhook examples.
MEDIARUNTIME_WEBHOOK_SECRET=

# Optional local/staging override for raw HTTP examples only.
# MEDIARUNTIME_BASE_URL=http://localhost:8001

# Active collection used by the server-side Hosted Sticker Runtime quickstart.
# Keep MEDIARUNTIME_API_KEY on the server; never copy it into a browser or mobile app.
MEDIARUNTIME_STICKER_COLLECTION_ID=
MEDIARUNTIME_STICKER_QUERY=beach
MEDIARUNTIME_STICKER_OUTPUT_PATH=sticker.webp

PORT=3000
