APP_NAME="MediaRuntime Video Pipeline"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=single
DB_CONNECTION=sqlite
SESSION_DRIVER=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database
MEDIARUNTIME_BASE_URL=https://mediaruntime.com
MEDIARUNTIME_API_KEY=
MEDIARUNTIME_WEBHOOK_SECRET=
MEDIARUNTIME_DELIVER_WEBHOOK=true
MEDIA_DISK=local
# MEDIA_ROOT=/absolute/private/work-directory
# MEDIA_LOCAL_ROOT=/absolute/private/saved-media
# For an S3-compatible bucket set MEDIA_DISK=s3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT=https://your-object-storage-endpoint
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional, local-only signed callback demonstration; never provider delivery.
DEMO_CALLBACK_SIMULATION=false
