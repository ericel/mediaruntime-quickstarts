# Private server credentials. Never commit .env.
MEDIARUNTIME_API_KEY=replace-with-your-key
# Register your HTTPS endpoint in the same account; copy its signing secret here.
MEDIARUNTIME_WEBHOOK_SECRET=replace-with-your-account-webhook-secret
MEDIARUNTIME_ACCOUNT_ID=acc_replace
DATABASE_URL=postgresql://tutorial:replace-password@127.0.0.1:5432/mediaruntime_webhooks
# Separate test database; tests refuse non-loopback or names without _test suffix.
TEST_DATABASE_URL=postgresql://tutorial:replace-password@127.0.0.1:5432/mediaruntime_webhooks_test
MEDIA_ROOT=./var/media
TEST_MEDIA_ROOT=./var/test-media
PORT=3000
WEBHOOK_PORT=3001
# Only used if starting the optional Compose PostgreSQL service.
POSTGRES_PASSWORD=replace-password
# PG_DATA_DIR=/your/external/disk/postgres
