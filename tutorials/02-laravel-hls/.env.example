APP_NAME="MediaRuntime HLS Tutorial"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=single
DB_CONNECTION=sqlite
SESSION_DRIVER=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database
MEDIARUNTIME_API_KEY=
MEDIARUNTIME_BASE_URL=https://mediaruntime.com
# Optional absolute path for uploaded inputs, downloaded bundles, and HLS outputs.
# MEDIA_ROOT=/Volumes/External_SSD/mediaruntime/laravel-media
